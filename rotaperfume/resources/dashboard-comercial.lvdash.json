{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas (fato_vendas)",
      "queryLines": [
        "-- Um dataset só, e de propósito: quando os widgets compartilham o dataset,\n",
        "-- clicar numa marca filtra a tela inteira. Datasets separados quebram isso.\n",
        "-- Repare no SQL: nenhum CAST, nenhum try_to_date. É o que a silver comprou.\n",
        "SELECT data_pedido, ano, mes, canal, segmento, cidade, uf,\n",
        "       marca, categoria, nota_olfativa,\n",
        "       pedido_id, cliente_id, quantidade, receita, custo, margem, devolucao\n",
        "FROM fato_vendas\n"
      ],
      "columns": [
        {
          "displayName": "Receita",
          "description": "Soma da receita, com devolução (negativa) inclusa.",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Margem",
          "description": "Receita menos custo do produto.",
          "expression": "SUM(`margem`)"
        },
        {
          "displayName": "Pedidos",
          "description": "Pedidos distintos, não cancelados.",
          "expression": "COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Ticket médio",
          "description": "Receita dividida pelo número de pedidos.",
          "expression": "SUM(`receita`) / NULLIF(COUNT(DISTINCT `pedido_id`), 0)"
        },
        {
          "displayName": "Margem %",
          "description": "Margem sobre receita.",
          "expression": "SUM(`margem`) / NULLIF(SUM(`receita`), 0)"
        }
      ]
    },
    {
      "name": "ds_top_clientes",
      "displayName": "Top 20 clientes",
      "queryLines": [
        "-- Grão diferente (um cliente por linha, já ranqueado), então dataset próprio.\n",
        "SELECT razao_social, segmento, cidade,\n",
        "       SUM(receita)                AS receita,\n",
        "       SUM(margem)                 AS margem,\n",
        "       COUNT(DISTINCT pedido_id)   AS pedidos\n",
        "FROM fato_vendas\n",
        "GROUP BY 1, 2, 3\n",
        "ORDER BY receita DESC\n",
        "LIMIT 20\n"
      ]
    }
  ],
